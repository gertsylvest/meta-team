{
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Grep(**)",
      "WebSearch",
      "WebFetch(*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(cp -r:*)",
      "Bash(mkdir:*)",
      "Bash(mkdir -p:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(perl:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(echo:*)",
      "Bash(command:*)",
      "Bash(claude:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(bash:*)",
      "Bash(taskmd:*)",
      "Bash(ctags:*)",
      "Bash(ast-grep:*)",
      "Bash(sg:*)",
      "Bash(cc:*)",
      "Bash(gcc:*)",
      "Bash(clang:*)"
    ]
  },
  "env": {
    "MESSAGING_TEAM": "meta-team"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/team-messaging/scripts/inbox-hook.sh\"; [ -f \"$f\" ] && bash \"$f\" session || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/team-messaging/scripts/inbox-hook.sh\"; [ -f \"$f\" ] && bash \"$f\" prompt || true"
          }
        ]
      }
    ]
  }
}
