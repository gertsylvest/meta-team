{
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Grep(**)",
      "WebSearch",
      "WebFetch(*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mkdir -p:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(bash:*)",
      "Agent(*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/team-messaging/scripts/inbox-hook.sh\"; [ -f \"$f\" ] && bash \"$f\" session || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/team-messaging/scripts/inbox-hook.sh\"; [ -f \"$f\" ] && bash \"$f\" prompt || true"
          }
        ]
      }
    ]
  }
}
